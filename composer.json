{
    "name": "voicebot/codeigniter-app",
    "description": "Prosta aplikacja CodeIgniter 3",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=7.4",
        "codeigniter/framework": "^3.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "scripts": {
        "post-install-cmd": [
            "php -r \"if (!is_dir('application/logs')) mkdir('application/logs', 0775, true);\""
        ]
    }
}
